generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tenancy ──────────────────────────────────────────────

model Org {
  id              String   @id @default(cuid())
  workosOrgId     String?  @unique
  name            String
  slug            String?  @unique
  onboardingStage String   @default("proposal_sent")
  // proposal_sent → proposal_approved → payment_complete → account_created
  // → brand_uploaded → connections_linked → reviews_approved → active
  stripeCustomerId String?
  stripeSubscriptionId String?
  subscriptionStatus   String?  // active, past_due, canceled
  brandColor      String?
  logoUrl         String?
  isAgency        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships  Membership[]
  proposals    Proposal[]
  leads        Lead[]
  customers    Customer[]
  deals        Deal[]
  approvals    Approval[]
  reviews      Review[]
  services     Service[]
  connections  Connection[]
  auditLogs    AuditLog[]
  payments     Payment[]
  socialPosts  SocialPost[]
  seoKeywords  SeoKeyword[]
  callRecords  CallRecord[]
  documents   Document[]
  websitePages WebsitePage[]
}

model User {
  id           String   @id @default(cuid())
  workosUserId String?  @unique
  email        String   @unique
  name         String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  auditLogs   AuditLog[]
}

model Membership {
  id     String   @id @default(cuid())
  userId String
  orgId  String
  role   String   @default("viewer") // owner, manager, viewer, agency_admin

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, orgId])
}

model AuditLog {
  id       String   @id @default(cuid())
  orgId    String
  userId   String?
  action   String
  entity   String
  entityId String?
  metadata Json?

  org  Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// ── Pitch / Gateway ──────────────────────────────────────

model Proposal {
  id     String  @id @default(cuid())
  orgId  String
  title  String
  pages  Json    // [{ name, sections: [{ heading, body, image }] }]
  status String  @default("draft") // draft, sent, approved, rejected
  token  String  @unique @default(cuid())

  org            Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payments       Payment[]
  changeRequests ChangeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChangeRequest {
  id         String  @id @default(cuid())
  proposalId String
  page       String
  elementRef String?
  request    String
  status     String  @default("pending") // pending, resolved

  proposal  Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Payment {
  id                   String  @id @default(cuid())
  orgId                String?
  proposalId           String?
  stripeSessionId      String?
  stripePaymentIntentId String?
  amount               Int     // cents
  type                 String  // one_time, subscription
  status               String  @default("pending") // pending, paid, failed, refunded

  org      Org?      @relation(fields: [orgId], references: [id])
  proposal Proposal? @relation(fields: [proposalId], references: [id])

  createdAt DateTime @default(now())
}

// ── CRM ───────────────────────────────────────────────────

model Lead {
  id      String   @id @default(cuid())
  orgId   String
  name    String
  email   String?
  phone   String?
  source  String?  // call, form, referral, organic
  status  String   @default("new") // new, contacted, qualified, lost
  notes   String?

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

model Customer {
  id      String   @id @default(cuid())
  orgId   String
  name    String
  email   String?
  phone   String?
  address String?
  value   Int?     // cents

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

model Deal {
  id         String   @id @default(cuid())
  orgId      String
  title      String
  customerId String?
  value      Int      // cents
  stage      String   @default("lead") // lead, contacted, qualified, proposal, won, lost

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stageEvents DealStageEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

// ── Approvals ────────────────────────────────────────────

model Approval {
  id      String   @id @default(cuid())
  orgId   String
  type    String   // ad, social, review, content
  title   String
  content Json?
  status  String   @default("pending") // pending, approved, rejected

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

// ── Reviews ──────────────────────────────────────────────

model Review {
  id      String  @id @default(cuid())
  orgId   String
  source  String // google, facebook, yelp
  author  String
  rating  Int
  content String?
  status  String @default("pending") // pending, approved, published

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ── Services ─────────────────────────────────────────────

model Service {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  price       Int      // cents
  cost        Int?     // cents
  active      Boolean  @default(true)

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

// ── Connections (integrations) ──────────────────────────

model Connection {
  id        String   @id @default(cuid())
  orgId     String
  provider  String   // google_ads, meta, callrail, stripe, etc.
  status    String   @default("pending") // pending, connected, error
  metadata  Json?

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

// ── Content calendar (socials + ads) ─────────────────────

model SocialPost {
  id           String   @id @default(cuid())
  orgId        String
  kind         String   // social, ad
  platform     String   // instagram, facebook, google_ads, ctv, …
  title        String
  copy         String?
  scheduledFor DateTime
  status       String   @default("awaiting_approval") // awaiting_approval, approved, changes_requested, published

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

// ── SEO rank tracking ───────────────────────────────────

model SeoKeyword {
  id          String @id @default(cuid())
  orgId       String
  term        String
  landingPage String
  position    Int
  change      Int    // signed positions moved since last pull
  volume      Int    // monthly searches

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

// ── Live calls (copilot) ─────────────────────────────────

model CallRecord {
  id          String   @id @default(cuid())
  orgId       String
  callerName  String
  phone       String?
  repName     String?
  durationSec Int      @default(0)
  status      String   @default("ended") // live, ended, missed
  sentiment   String?  // Warming, Neutral, Cooling
  summary     String?
  transcript  Json?    // [{ who: "lead" | "rep", text }]
  startedAt   DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orgId])
}

// ── Documents (brand wiki) ───────────────────────────────

model Document {
  id       String   @id @default(cuid())
  orgId    String
  title    String
  category String   // PDF, DOCX, TXT, …
  content  String?
  size     String?
  status   String   @default("indexed") // processing, indexed, locked

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

// ── Website pages (build status) ─────────────────────────

model WebsitePage {
  id     String  @id @default(cuid())
  orgId  String
  title  String
  path   String
  status String  @default("live") // building, in_review, live, needs_work
  note   String?

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

/// Webhook/publish idempotency ledger (Build Plan §1.9).
/// Providers retry deliveries; a processed event is never handled twice.
model ProcessedEvent {
  id          String   @id @default(cuid())
  /// Provider's own event id, or an Idempotency-Key for publish actions.
  eventId     String
  source      String   // stripe, meta, google, composio, internal
  eventType   String?
  processedAt DateTime @default(now())

  @@unique([source, eventId])
}

/// Deal stage history, so pipeline drags are auditable and reportable.
model DealStageEvent {
  id        String   @id @default(cuid())
  orgId     String
  dealId    String
  fromStage String?
  toStage   String
  userId    String?
  createdAt DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([dealId])
}
